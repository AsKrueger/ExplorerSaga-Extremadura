    <string name="about_title">Privacidad y licencias</string>
    <string name="privacy_title">Privacidad</string>
    <string name="privacy_text">ExplorerSaga no tiene cuentas de usuario, ni analítica, ni rastreadores publicitarios. Si das permiso de ubicación, se usa solo en tu móvil para ordenar los lugares por cercanía y nunca se envía a ningún servidor. Tus favoritos, el contenido y el mapa descargado se guardan en el móvil y puedes borrarlos desde Ajustes.</string>
