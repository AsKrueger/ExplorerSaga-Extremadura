    <!-- About -->
    <string name="about_title">Privacy and licences</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_text">ExplorerSaga has no user accounts and no advertising trackers. If you grant location access, it is only used on your phone to sort places by distance and is never sent to any server. Saved places, images and maps are stored on your phone and you can delete them from Settings. Maps are downloaded from OpenStreetMap servers.</string>
    <string name="about_data_title">Data and maps</string>
    <string name="about_data_text">Maps and some places: © OpenStreetMap contributors, available under the Open Database License (ODbL). Some descriptions come from Wikipedia and are published under the CC BY-SA 4.0 licence.</string>
    <string name="about_open_osm">View the OpenStreetMap licence</string>
    <string name="about_fonts_title">Fonts</string>
    <string name="about_fonts_text">Montserrat and Playfair Display, under the SIL Open Font License 1.1.</string>
    <string name="about_software_title">Open-source software</string>
    <string name="about_software_text">Android Jetpack (Compose, Room, Navigation, DataStore), Kotlin, Coil, Retrofit, OkHttp and osmdroid, under the Apache 2.0 licence.</string>
