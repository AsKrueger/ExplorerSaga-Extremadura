    <!-- About -->
    <string name="about_title">Privacy and licences</string>
    <string name="privacy_title">Privacy</string>
    <string name="privacy_text">ExplorerSaga has no user accounts, analytics or ad trackers. If you allow location, it is only used on your phone to sort places by distance and is never sent to any server. Your favourites, the content and the downloaded map are stored on your phone and you can delete them in Settings.</string>
    <string name="about_open_privacy">Read the full privacy policy</string>
    <string name="about_data_title">Data and maps</string>
    <string name="about_data_text">Places and maps: © OpenStreetMap contributors (ODbL licence), with tiles from OpenFreeMap. Descriptions from Wikipedia (CC BY-SA 4.0) and data from Wikidata (CC0). Photos from Wikimedia Commons, each credited with its author and licence on its page. Accommodation register: Junta de Extremadura open data (CC BY 4.0).</string>
    <string name="about_open_osm">View the OpenStreetMap licence</string>
    <string name="about_photo_title">Cover photo</string>
    <string name="about_photo_text">“Teatro romano de Mérida. España-3” by Lmbuga (Luis Miguel Bugallo Sánchez), Wikimedia Commons, CC BY-SA 4.0 licence.</string>
