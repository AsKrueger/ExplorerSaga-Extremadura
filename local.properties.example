## Archivo de configuración local para Android SDK
# Copia este archivo como 'local.properties' en la raíz del proyecto si compilas desde terminal sin abrir Android Studio.
#
# Ejemplos de ubicación según el Sistema Operativo:
# - Windows: sdk.dir=C\:/Users/TU_USUARIO/AppData/Local/Android/Sdk
# - Linux: sdk.dir=/home/TU_USUARIO/Android/Sdk
# - macOS: sdk.dir=/Users/TU_USUARIO/Library/Android/sdk

sdk.dir=C\:/Users/TU_USUARIO/AppData/Local/Android/Sdk

# Dirección que recibe los comentarios enviados desde Ajustes > Enviar comentarios.
# Si se deja vacía, la app abre el correo sin destinatario.
feedback.email=

# Firma de la versión de Google Play (opcional en desarrollo).
# Crea el keystore una sola vez y guárdalo fuera del repositorio, con copia de seguridad:
#   keytool -genkeypair -v -keystore explorersaga-release.jks -keyalg RSA -keysize 4096 -validity 10000 -alias explorersaga
# release.storeFile=C:/ruta/segura/explorersaga-release.jks
# release.storePassword=
# release.keyAlias=explorersaga
# release.keyPassword=
